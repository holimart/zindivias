{
  "schema_version": "1.0.0",
  "audit_id": "v2-strata-descriptive-audit",
  "backlog_item": "bias-v2-strata-descriptive-audit",
  "title": "Feature-only descriptive distribution of the frozen v2 candidate across provided equity strata",
  "intent": "Descriptive screen only. Reports how the frozen v2 predictions are distributed across strata that the organisers provided, so prediction patterns can be reviewed. This is not model promotion, not a validation score, and not an accuracy assessment; no organiser target is estimated or implied.",
  "prohibitions": {
    "sample_score_placeholder_values_read": false,
    "labels_used": false,
    "public_leaderboard_scores_used": false,
    "removed_reference_layers_or_equivalent_copies_read": false,
    "per_tract_tuning_performed": false,
    "proxy_estimates_presented_as_organizer_targets": false,
    "candidate_modified": false,
    "upload_performed": false
  },
