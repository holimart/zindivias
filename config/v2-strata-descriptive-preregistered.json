      "transport": "transport_gap",
      "building": "building_gap",
      "poi": "poi_gap"
    },
    "component_defined_columns": {
      "transport": "route_reference_transport_defined",
      "building": "building_defined",
      "poi": "v2_raw_poi_defined"
    },
    "manifest": "reports/candidates.json",
    "build_audit": "reports/estimator-v2-audit.json",
    "template_only_fill": 0.0,
    "official_scored_rows": 9379,
    "template_only_rows": 415,
    "template_only_region": "eastern-wa"
  },
  "frozen_pins": {
    "mask_config": "config/v2-component-mask-audit-preregistered.json",
    "mask_audit": "reports/v2-defined-mask-audit.json",
    "provenance_config": "config/v2-input-provenance-preregistered.json",
    "provenance_manifest": "reports/candidates/v2_input_provenance_manifest.json",
    "prior_strata_reports": [
      "reports/discovery-rural-svi-minority.json",
      "reports/discovery-strata-confound.json",
      "reports/discovery-ok-tribal-ems.json",
      "reports/confidence-by-stratum.json"
    ]
  },
  "quantiles": [0.05, 0.25, 0.5, 0.75, 0.95],
  "quantile_method": "nearest-rank on the ascending sorted group values: index = max(0, ceil(q * n) - 1); deterministic and independent of interpolation",
  "contrast_tolerance": 1e-12,
  "arithmetic": {
    "mean": "float64 sum divided by n, and independently an exact rational sum of the decimal strings divided by n",
    "contrast": "max group mean minus min group mean over the stratum's present groups",
    "reproduction": "abs(float contrast - exact rational contrast) must be <= contrast_tolerance for every stratum"
  },
  "missing_strata_policy": {
    "declared": "Every stratum group is formed only from a non-null provided value. Nulls fall into the single explicit missing label; they are never zero-filled, region-mean filled, or dropped from the stratum total.",
    "absent_column": "A stratum whose column is absent from the provided schema is reported with status not_available_in_provided_inputs, zero groups, and is never imputed.",
    "derived_undefined": "Derived strata record an explicit undefined label for mathematically undefined operands (for example zero land area) instead of imputing a value."
  },
  "strata_family_provenance": {
    "provided_input_file": "defined-flags-inputs/<region>-strata-tract-table.parquet (organiser-provided, hashed against the frozen input-provenance manifest)",
    "documentation": "docs/data-inventory.md records the provided strata schema column-by-column for every region",
    "note": "SVI, CVI, RUCA/RUCC, NCHS, tribal, USDM, USFS, MTBS, NIFC, FOD, GEHE, HWD/UHE, PMDI/SPI and CarbonPlan columns are organiser-provided equity/hazard strata inside that provided file. They are not the removed reference layers (TIGER roads, MS Buildings, USGS facilities, CBP establishments), which are absent from every provided file and are never read here. Because the frozen scored candidate may not read these strata columns, every column outside the permitted model-input subset is descriptive-only and its absence from every model-chain script is measured.",
    "removed_reference_layers_read": false
  },
  "forbidden_source_scan": {
    "prohibited_path_tokens": [
      "submissions.jsonl",
      "data/ledger",
      "lb-score-algebra",
