    ],
    "placeholder_columns_source": "config/v2-input-provenance-preregistered.json:prohibited.score_placeholder_columns_in_provided_samples"
  },
  "model_input_separation": {
    "note": "The scored v2 candidate may read only the permitted provided strata columns recorded in the frozen input-provenance audit. Columns beyond that subset are read by this descriptive audit only and must not appear in any model-chain script.",
