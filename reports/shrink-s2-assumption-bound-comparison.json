  "recipe": {
    "base": "C2_component_estimator_v0 component outputs and reports/gap-estimates.csv per-component defined flags; this is the frozen feature-only component recipe audited by H1b. Do not use S as a base and do not apply S's cross-method reliability weights or region-mean shrink.",
    "building": {
      "assumption": "A Microsoft-sourced Overture record is treated as an exact overlap with the removed Microsoft reference solely for this counterfactual; this is unverified and not accuracy evidence",
      "defined_mask": "preserve C2 building_defined",
      "rule": "when share is finite and in [0,1], building_gap_S2 = building_gap_C2 * (1 - share); when share is missing, preserve building_gap_C2 unchanged",
      "source_share": "provided per-tract overture_building_microsoft_source_share"
    },
    "coefficient_or_fit": "none; no fitted/estimated coefficients, target moments, or S-style shrink",
    "input_construction_ambiguity": "H1b's exact component-level stress-test is defined on C2 and its frozen per-type recipe values. A1/A2/A3 expose aggregate component columns but no separate facility-type decompositions, so S2 uses the exact C2/H1b component path rather than inventing per-type splits for A-family candidates. S and C2 remain explicit comparison baselines.",
    "overall_composite": "arithmetic mean of the defined transport, adjusted building, and adjusted POI component values; omit undefined components; deterministic 0.0 export fallback only if no component is defined",
    "poi_composite": "mean of whichever facilities half and establishment half are defined; undefined if neither is defined; preserve no hidden-reference mask",
    "poi_establishments": "preserve the frozen cbp_gap/cbp_defined establishment half without correction; this is an internal feature-only proxy, not a CBP reference count",
    "poi_facilities": {
      "assumption": "Overture category count zero is treated as a zero reference count for this scenario only; USGS reference counts are absent and this premise is unverified",
      "inputs": "fire_gap/fire_defined, ems_gap/ems_defined, schools_gap/schools_defined from frozen reports/gap-estimates.csv plus raw Overture category counts from provided tract summaries",
      "rule": "drop each facility type from the facilities half iff that tract's raw overture_poi_<type> count is exactly zero; retain other types only when their frozen per-type defined flag is true; facilities half is the arithmetic mean of retained defined type gaps, or undefined if no type remains"
    },
    "transport": "preserve C2 transport_gap and transport_defined unchanged"
  },
  "reproduction": {
    "command": "uv run --with-requirements requirements.txt python scripts/build_shrink_s2_assumption_bound.py --workspace $COMPETITION_WORKSPACE",
    "tests": "uv run --with-requirements requirements.txt --with pytest python -m pytest -q tests/test_shrink_s2_assumption_bound.py"
  },
