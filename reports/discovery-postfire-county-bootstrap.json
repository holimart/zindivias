  "config_sha256": "2ca6d50917ee16811278712e707c883cbf477503c8886bc2073ff28c42a0ff83",
  "design_substitution_after_results_forbidden": true,
  "intent": "Robustness screen for one documented Best Bias Discovery finding: the difference between high-burn and unburned Northern California tracts in the share whose provided Overture-to-USFS building-count ratio falls below the preregistered disagreement cutoff. The published finding was bootstrapped by resampling tracts independently, which understates county-level dependence because tracts in one county share Overture provider mix, terrain and reference vintage. This audit rechecks that difference by resampling whole counties. It is a robustness screen, not model promotion, not an accuracy assessment, and not an estimate of any organiser target.",
  "lane": "comp-zindi-bias-bounty",
  "negative_controls": [
   {
    "case": "drop_inconvenient_county",
    "expect_failed_gate": "no_county_dropped",
    "mutation": "remove county 033, the largest high-burn contributor, from the resampling pool"
   },
   {
    "case": "tract_resample_disguised_as_cluster",
    "expect_failed_gate": "clusters_are_whole_counties",
    "mutation": "treat every tract as its own cluster, i.e. resample tracts while claiming counties"
   },
   {
    "case": "cutoff_retuned",
    "expect_failed_gate": "cutoff_not_tuned",
    "mutation": "compute the indicator with cutoff 0.9 instead of the preregistered 0.8"
   },
   {
    "case": "seed_or_replicates_changed",
    "expect_failed_gate": "replicates_and_seed_as_preregistered",
    "mutation": "run 1000 replicates under a different seed"
   },
   {
    "case": "point_estimate_perturbed",
    "expect_failed_gate": "point_estimate_matches_frozen_report",
    "mutation": "assert a frozen point difference of 0.11 instead of the published value"
   },
   {
    "case": "unmutated_control",
    "expect_failed_gate": null,
    "mutation": "none"
   }
  ],
  "primary_design": {
   "cluster_unit": "county (provided COUNTYFP)",
   "draws_per_replicate": "one draw per county in the pool (resample with replacement, equal size)",
   "id": "joint_county_cluster_multinomial",
   "interval": "percentile 2.5 and 97.5 of the valid replicates",
   "pool": "every county present in the analysis population, each draw uniform over the pool",
   "replicates": 50000,
   "rng": "numpy.random.default_rng(seed).multinomial(draws, [1/K]*K, size=replicates)",
   "seed": 20261025,
   "statistic": "share(ratio < cutoff | high_burn) - share(ratio < cutoff | unburned), computed inside each replicate",
   "tract_handling": "all tract records of a selected county enter the replicate, including tracts of every burn class",
   "valid_replicate": "the replicate contains at least one high-burn tract and at least one unburned tract"
  },
  "primary_design_rationale": "The row requires 'resampling whole counties and preserving all tract records in each selected county'. Only the joint county resample of the whole analysis population preserves every tract record of a selected county; a within-group county resample would keep only the focal burn class of the selected county and therefore drops records, so it cannot be the primary design. It is retained as a declared secondary sensitivity that cannot change the verdict.",
