  "frozen_rules": {
    "building": {
      "defined": "overture_building_count > 0",
      "gap": "0.01 (fixed residual prior BUILDING_GAP_V2) when defined",
      "undefined_placeholder": 0.0
    },
    "composite": {
      "components": [
        "transport",
        "building",
        "poi"
      ],
      "rule": "arithmetic mean of the top-level components whose model-defined flag is 1; undefined components are excluded entirely",
      "undefined_placeholder": 0.0,
      "zero_defined_rule": null,
      "zero_defined_rule_note": "No zero-defined fallback rule is registered. Acceptance requires zero such rows; a nonzero count fails the audit rather than silently emitting a placeholder."
    },
    "establishments": {
      "cbp_k": 0.024,
      "defined": "pop_total > 0 or all_overture_poi_count > 0",
      "formula": "clip(1 - all_overture_poi_count / (cbp_k * pop_total), 0, 1)",
      "undefined_placeholder": 0.0,
      "zero_population_positive_count_gap": 0.0
    },
    "facility_family": {
      "defined": "probability > 0",
      "density_index": "log1p((pop_total / max(ALAND km2, 0.01)) / 100)",
      "gap": "probability * clip(1 - n / (n + 1), 0, 1) with n the Overture count after the fixed unclassified allocation",
      "presence_prior": {
        "ems": {
          "intercept": -3.2,
          "log_density": 0.25,
          "urban_fraction": 0.6
        },
        "fire": {
          "intercept": -2.8,
          "log_density": 0.3,
          "urban_fraction": 0.7
        },
        "schools": {
          "intercept": -1.0,
          "log_density": 0.2,
          "urban_fraction": 0.35
        }
      },
      "probability": "sigmoid(intercept + log_density * density_index + urban_fraction * urbanity), logit clamped to [-30, 30]",
      "undefined_placeholder": 0.0,
      "urbanity": "pct_urban when finite, else pop_urban/pop_total for positive population, else neutral 0.5"
    },
    "poi": {
      "combiner": "equal-weight mean of the defined facility and establishments halves",
      "defined": "facility_half_defined or establishments_half_defined",
      "facility_half": "mean of defined fire/EMS/schools gaps",
      "undefined_placeholder": 0.0
    },
    "transport": {
      "defined": "overture_route_km > 0",
      "gap": "clip(1 - overture_named_road_km_5070 / overture_route_km, 0, 1)",
      "undefined_placeholder": 0.0
    }
  },
