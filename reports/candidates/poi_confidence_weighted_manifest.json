{
  "aggregation": {
    "candidate_defined": "the v2 POI definedness flag from the preceding component-composition rule; weighted count equal to zero is observed absence under the fixed presence prior, not an undefined score",
    "establishments_half": "hold the existing provided-feature-only v2 establishments component fixed at preregistered analysis sensitivity k_pop=0.024; do not use removed CBP values",
    "facility_gap": "for each type apply the existing pooled v2 logistic presence prior and expected-miss function to (threshold-weighted selected family count + unchanged v2 unclassified allocation); average the defined fire, EMS, and school type gaps",
    "missing_or_invalid_confidence": "zero weight for the weighted numerator, retain the raw count, and report missing/invalid counts; do not impute confidence",
    "no_accuracy_tuning": true,
    "poi_gap": "equal mean of whichever facility and establishments halves are defined, matching the existing v2 POI composition",
    "raw_family_count": "count each provided POI once per exact selected category family matched by primary or any alternate category",
    "sources": "report dataset presence/source mix for matched family records; no source-dependent weight or source-defined quality ranking is imposed",
    "unclassified_category_rows": "retain the existing fixed v2 treatment: no-category rows are allocated by the region-level family-share ratios computed from all categorized POIs; keep this allocation identical across raw and threshold variants so the sensitivity isolates weighting of selected categorized POIs",
    "weighted_family_count": "sum confidence for selected-family POIs with valid finite confidence in [0,1] and confidence >= threshold; otherwise contribute zero; each POI counts at most once per family"
  },
