      "existing provided-feature overture_buildings count solely for count reconciliation"
    ],
    "candidate_id": "B_MORPH_V1",
    "component_rule": {
      "baseline": "0.01 if provided Overture building count > 0; otherwise undefined with numeric placeholder 0 and building_defined=0",
      "baseline_gap_value": 0.01,
      "clip_range": [
        0.0,
        0.1
      ],
      "coefficient_rationale": "fixed conservative perturbation envelope around the existing 0.01 near-zero baseline; no target or leaderboard fit",
      "morphology_candidate": "0.01 + beta * (1 - morphology_support) when building_defined=1; otherwise numeric placeholder 0 and building_defined=0",
