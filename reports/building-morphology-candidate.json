      "MS, USFS, CarbonPlan, or other reference footprint counts or geometries",
      "external imagery or external footprint data",
      "ACS housing-unit counts as a denominator or floor",
      "leaderboard or score-derived calibration"
    ],
    "morphology_support": {
      "features": [
        "structure_density = clip(log1p(building_count / max(ALAND_km2, 0.01)) / log1p(1000 buildings_per_km2), 0, 1)",
        "median_area = clip(log1p(median valid projected footprint area_m2) / log1p(500 m2), 0, 1); zero if no valid geometry",
        "verticality = mean over assigned buildings of clip(max(num_floors when positive else height_m/3 when positive else 0) / 4, 0, 1)",
        "subtype_support = share of assigned buildings with non-null non-empty subtype",
        "parts_support = share of assigned buildings with has_parts=true",
        "population_context = clip(log1p(pop_total / max(ALAND_km2, 0.01)) / log1p(10000 people_per_km2), 0, 1)"
      ],
      "scales": {
        "density_buildings_per_km2": 1000.0,
        "median_area_m2": 500.0,
        "metres_per_floor": 3.0,
        "population_per_km2": 10000.0,
        "vertical_floors": 4.0
      },
      "support_formula": "arithmetic mean of the six listed bounded features; all weights frozen equally",
